# =============================================================================
# SynPharm 环境变量模板
#
# 使用方法：复制本文件为 .env 并修改其中的值（.env 已被 gitignore，不会提交）
#   Windows: copy .env.example .env
#   Linux/Mac: cp .env.example .env
#
# 生成强随机密钥（生产环境必做）：
#   openssl rand -hex 32
# =============================================================================

# ---------- 版本标签（用于镜像命名）----------
SYNPHARM_VERSION=1.0.0

# ---------- MySQL ----------
# 生产环境请务必修改！生成示例：openssl rand -base64 18
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=synpharm
MYSQL_USER=synpharm
MYSQL_PASSWORD=change-me-synpharm
# Windows 可能已有本地 MySQL 监听 3306；且 3307-3406 属 Windows/Hyper-V 保留端口段（绑定会报
# "access a socket in a way forbidden"），故改用保留段外的 13307 避免冲突
MYSQL_PORT=13307

# ---------- 各服务独立数据库账号（决策 B：每服务独立 schema + 独立账号）----------
# 全新安装由 sql/00_create_accounts.sh 在数据卷为空时自动创建（口令从这些变量读取）；
# 已部署环境请参考 sql/migrations/ 里的迁移脚本手工建账号。
# 生成强随机口令：openssl rand -hex 16
AUTH_DB_USER=synpharm_auth
AUTH_DB_PASSWORD=

# ---------- 阶段 2：药物设计 ----------
# 只对 synpharm_design schema 有权限（拆分铁律 R2）
DESIGN_DB_USER=synpharm_design
DESIGN_DB_PASSWORD=

# ---------- 阶段 3：资产 ----------
ASSET_DB_USER=synpharm_asset
ASSET_DB_PASSWORD=

# ---------- 阶段 4：预测 ----------
PREDICT_DB_USER=synpharm_predict
PREDICT_DB_PASSWORD=

# ---------- 阶段 5：平台 ----------
PLATFORM_DB_USER=synpharm_platform
PLATFORM_DB_PASSWORD=

# ---------- 服务间内部口令（安全关键）----------
# 网关用它证明「请求确实经过网关」，下游据此信任 X-User-Id 等身份头。
# 未配置时下游会 fail-closed 地忽略全部身份头（鉴权接口一律 401）。
# 生成：openssl rand -hex 24
INTERNAL_TOKEN=

# ---------- Redis ----------
# 内网开发默认无密码；生产请设置强密码并同步给后端 REDIS_PASSWORD
# Windows 可能已有本地 Redis 监听 6379，使用 6380 避免冲突
REDIS_PORT=6380
REDIS_PASSWORD=

# ---------- JWT（安全关键，生产必须设为 32 字节以上的强随机值）----------
# 生成：openssl rand -hex 32；留空则后端启动失败（fail-fast），禁止使用可猜密钥
JWT_SECRET=
JWT_EXPIRATION=86400000

# ---------- 验证码（安全关键）----------
# 显式开发模式开关：true 时验证码直接返回给前端（仅限本地/测试，生产必须为 false）
CAPTCHA_DEV_MODE=false

# ---------- RabbitMQ（批量任务消息队列）----------
RABBITMQ_USER=synpharm
# 生产请设置强密码（生成：openssl rand -base64 18）
RABBITMQ_PASSWORD=

# ---------- FastAPI 算法引擎 ----------
# 宿主机映射端口。取 15000 以上：Windows 动态端口范围为 1024-15000，
# 落在其中的端口会被随机保留导致无法绑定
FASTAPI_PORT=18050
# 推理设备：cpu / cuda:0
FASTAPI_DEVICE=cpu
FASTAPI_BATCH_SIZE=50
# 后端调用算法引擎时携带的单一 API Key（开启认证必填，如 synpharm-secret-key）
FASTAPI_API_KEY=
# FastAPI 接受的全部 API Key（逗号分隔，可多个）；留空则回退到 FASTAPI_API_KEY；
# 两者都留空 = 关闭认证（仅限内网开发）
FASTAPI_API_KEYS=
FASTAPI_LOG_LEVEL=INFO

# ---------- SpringBoot 后端 ----------
# 注意：8080 现在属于**网关**（synpharm-gateway），不再是后端。
# 网关刻意占用 8080（而非文档里的 7000）：前端 src/utils/request.ts 在 dev 下把 API 基址
# 硬编码回退到 http://localhost:8080（VITE_API_BASE_URL 为空串时 falsy，走该分支），
# 且 docker-compose.dev.yml 把 frontend 的 VITE_API_BASE_URL 固定为 ""。
# 把网关映射到宿主 8080 即可前后端零改动联通。
BACKEND_PORT=8080

# 后端直连端口：8080 让给网关后，此端口仅在需要绕过网关排查问题时使用。
# 取 15000 以上：Windows 动态端口范围为 1024-15000，落在其中的端口会被随机保留导致无法绑定。
BACKEND_DIRECT_PORT=18081

# ---------- Nacos（注册中心 + 配置中心）----------
# 宿主端口取 15000 以上（Windows 动态端口范围 1024-15000）
NACOS_PORT=18848
# Nacos 2.x 的 gRPC 端口固定为「主端口 + 1000」，本机直接跑客户端时需要可访问
NACOS_GRPC_PORT=19848
# 客户端连接 Nacos 使用的账号（服务端开启鉴权后必填）
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
# 宿主机直连 Nacos 的地址（在本机跑 gateway/backend 而不进容器时使用）
NACOS_SERVER_ADDR=localhost:18848

# --- 以下三项仅生产（docker-compose.yml）需要，开发环境（docker-compose.dev.yml）不校验 ---
# 开启鉴权后必须设置；生成：openssl rand -base64 48（≥32 字节）
NACOS_AUTH_TOKEN=
# 服务端身份识别，成对使用，随意但必须非空
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=

# 网关是否强制拦截未通过鉴权的请求。
# 阶段 0 必须为 false（由后端自行鉴权，行为与拆分前一致）；抽走 auth 服务后改 true。
GATEWAY_AUTH_ENFORCE=false

# ---------- 前端 ----------
# 容器内 Nginx 监听 8080，映射到宿主机端口（默认 80）
FRONTEND_PORT=80

# ---------- QQ 邮箱（可选，用于发送验证码；留空则无法发送邮件）----------
QQ_EMAIL=
QQ_EMAIL_AUTH_CODE=
