<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.synpharm</groupId>
        <artifactId>synpharm-cloud</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>synpharm-common</artifactId>
    <packaging>jar</packaging>
    <name>SynPharm Common</name>
    <description>公共库：统一响应信封、错误码、异常、内部透传头与键约定</description>

    <!--
      依赖范围（关键约束）：网关是 reactive 栈、业务服务是 servlet 栈。
      公共库里的共享组件（InternalRequestFilter / GlobalExceptionHandler / MybatisPlusConfig 等）
      需要 servlet 栈与 MyBatis-Plus，故这些 starter 一律声明为 provided：
      本模块编译与测试可见，但不向下游传递 —— 否则 spring-boot-starter-web 会经 synpharm-common
      进入 gateway 的 classpath，Spring MVC 与 Spring Cloud Gateway 并存会导致网关直接启动失败。
    -->
    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <!-- JsonCodec 的构造参数就是 ObjectMapper，属于对外 API（compile 范围，各模块 web starter 已带同版本） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- servlet 栈共享组件：内部身份过滤器 + 全局异常处理器 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- GlobalExceptionHandler 处理 ConstraintViolationException 需要 jakarta.validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- MybatisPlusConfig / PageResult 需要 MyBatis-Plus -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- 纯库模块，不打可执行 jar -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
